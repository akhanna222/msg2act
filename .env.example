# Application Settings
APP_NAME=msg2act
APP_VERSION=0.1.0
DEBUG=True
API_V1_PREFIX=/api/v1

# Security (IMPORTANT: Generate secure keys for production!)
# Generate SECRET_KEY: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here-generate-with-fernet

# Database
POSTGRES_USER=msg2act
POSTGRES_PASSWORD=msg2act_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=msg2act

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Google OAuth (Get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Microsoft OAuth (Optional - for Outlook integration)
# Get from https://portal.azure.com/
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# OpenAI API (for advanced extraction and form filling)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic API (Optional alternative to OpenAI)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Email Sync Settings
GMAIL_BATCH_SIZE=100
GMAIL_MAX_RESULTS=500
GMAIL_SYNC_INTERVAL_MINUTES=5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=/tmp/msg2act/uploads

# Frontend URL
FRONTEND_URL=http://localhost:5173
